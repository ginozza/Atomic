<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient resonance wave -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2500F0FF"
        android:strokeWidth="1.0"
        android:pathData="M 37,54 a 17,17 0 1,0 34,0 a 17,17 0 1,0 -34,0" />

    <!-- Electron Orbit 1 (30 degrees) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="30">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#00F0FF"
            android:strokeWidth="2.2"
            android:pathData="M 26,54 a 28,10.5 0 1,0 56,0 a 28,10.5 0 1,0 -56,0" />
        <path
            android:fillColor="#00FFA3"
            android:pathData="M 81.5,54 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 83,54 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />
    </group>

    <!-- Electron Orbit 2 (90 degrees) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="90">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#00FFA3"
            android:strokeWidth="2.2"
            android:pathData="M 26,54 a 28,10.5 0 1,0 56,0 a 28,10.5 0 1,0 -56,0" />
        <path
            android:fillColor="#00F0FF"
            android:pathData="M 81.5,54 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 83,54 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />
    </group>

    <!-- Electron Orbit 3 (150 degrees) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="150">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#38BDF8"
            android:strokeWidth="2.2"
            android:pathData="M 26,54 a 28,10.5 0 1,0 56,0 a 28,10.5 0 1,0 -56,0" />
        <path
            android:fillColor="#00FFA3"
            android:pathData="M 81.5,54 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 83,54 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />
    </group>

    <!-- Glowing Nucleus Core -->
    <path
        android:pathData="M 44,54 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="10"
                android:type="radial">
                <item android:color="#FF00F0FF" android:offset="0.0" />
                <item android:color="#8000FFA3" android:offset="0.6" />
                <item android:color="#0000F0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#00F0FF"
        android:pathData="M 48.5,54 a 5.5,5.5 0 1,0 11,0 a 5.5,5.5 0 1,0 -11,0" />
