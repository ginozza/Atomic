<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_tiny_root"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:background="@drawable/bg_island_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/iv_tiny_cover"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_rounded_cover"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tv_tiny_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxWidth="120dp"
        android:singleLine="true"
        android:text="Nuclear Music"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_tiny_wave"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_music_wave" />

</LinearLayout>
